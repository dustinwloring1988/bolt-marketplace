{
  "schemaVersion": 1,
  "pluginApiVersion": 1,
  "id": "bolt.demo",
  "name": "Bolt Demo Plugin",
  "description": "Demonstration plugin showing how to hide example prompts and blank apps on the homepage",
  "publisher": "bolt",
  "license": "MIT",
  "category": "Developer Tools",
  "version": "1.0.0",
  "icon": "assets/icon.png",
  "tools": ["count", "transform"],
  "settings": [
    {
      "key": "hideExamplePrompts",
      "label": "Hide Example Prompts",
      "type": "toggle",
      "default": true
    },
    {
      "key": "hideBlankApps",
      "label": "Hide Blank Apps",
      "type": "toggle",
      "default": true
    }
  ]
}
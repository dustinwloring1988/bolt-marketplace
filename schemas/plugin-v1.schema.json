{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dustinwloring1988/bolt-marketplace/schemas/plugin-v1.schema.json",
  "title": "Bolt plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pluginApiVersion", "id", "name", "description", "publisher", "license", "category", "version", "contribution", "capabilities", "tools"],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,48}\\.[a-z0-9][a-z0-9-]{0,48}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "path": { "type": "string", "pattern": "^plugins/[a-z0-9][a-z0-9-]{0,48}/[a-z0-9][a-z0-9-]{0,48}/[0-9A-Za-z.-]+/[a-zA-Z0-9._/-]+$", "not": { "pattern": "(^|/)\\.\\.?(/|$)|\\\\" } },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "pluginApiVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 400 },
    "publisher": { "type": "string", "minLength": 1, "maxLength": 80 },
    "license": { "type": "string", "minLength": 1, "maxLength": 40 },
    "category": { "enum": ["AI", "Developer Tools", "Productivity", "Data", "Media", "Communication", "Other"] },
    "version": { "$ref": "#/$defs/version" },
    "minAppVersion": { "$ref": "#/$defs/version" },
    "icon": { "type": "string", "pattern": "^assets/[a-zA-Z0-9._-]+\\.(png|jpg|jpeg|webp)$" },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "adapter"],
      "properties": { "type": { "const": "host-tool" }, "adapter": { "const": "text-utils" } }
    },
    "capabilities": { "type": "array", "maxItems": 0 },
    "tools": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["count", "transform"] } },
    "settings": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "type"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]{0,31}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 64 },
          "type": { "enum": ["text", "toggle", "number"] },
          "description": { "type": "string", "maxLength": 160 },
          "default": { "type": ["string", "boolean", "number"] }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dustinwloring1988/bolt-marketplace/schemas/catalog-v1.schema.json",
  "title": "Bolt plugin catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "plugins": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "versions"],
        "properties": {
          "id": { "$ref": "plugin-v1.schema.json#/$defs/id" },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "manifestPath", "manifestSha256", "packagePath", "packageSha256"],
              "properties": {
                "version": { "$ref": "plugin-v1.schema.json#/$defs/version" },
                "manifestPath": { "$ref": "plugin-v1.schema.json#/$defs/path" },
                "manifestSha256": { "$ref": "plugin-v1.schema.json#/$defs/sha256" },
                "packagePath": { "$ref": "plugin-v1.schema.json#/$defs/path" },
                "packageSha256": { "$ref": "plugin-v1.schema.json#/$defs/sha256" },
                "changelogPath": { "$ref": "plugin-v1.schema.json#/$defs/path" }
              }
            }
          }
        }
      }
    }
  }
}
